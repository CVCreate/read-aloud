.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.topbar {
  flex: none;
  padding: 0 24rpx;
  height: 96rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 3rpx solid var(--line);
  background: var(--card);
}
.topbar__btn {
  min-width: 132rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  border: 3rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--card);
}
.topbar__btn:active { background: var(--chip); }
.topbar__btn--warn { color: var(--stop); }
.topbar__ico { width: 36rpx; height: 36rpx; margin: 0 8rpx; flex: none; }
.topbar__title {
  flex: 1;
  min-width: 0;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}
.topbar__btn { flex: none; }

.list {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx;
}

.card {
  display: flex;
  align-items: stretch;
  margin-bottom: 20rpx;
  background: var(--card);
  border: 4rpx solid var(--line);
  border-radius: 24rpx;
  overflow: hidden;
}
.card__main {
  flex: 1;
  padding: 22rpx 24rpx;
  min-width: 0;
}
.card__main:active { background: var(--chip); }
.card__head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.card__ico { width: 36rpx; height: 36rpx; margin-right: 10rpx; flex: none; }
.card__del-ico { width: 40rpx; height: 40rpx; }
.card__time {
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 700;
}
.card__count {
  margin-left: auto;
  font-size: 26rpx;
  color: var(--ink-2);
}
.card__text {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.6;
  color: var(--ink);
  word-break: break-all;
}
.card__cta {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--go-dark);
}

.card__del {
  flex: none;
  width: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-left: 4rpx solid var(--line);
  background: #FBE9E7;
}
.card__del:active { background: #FFCCBC; }

/* 底部安全区补偿：全面屏机型的手势条会盖住最后一张卡片 */
.bottom-pad {
  height: 40rpx;
  height: calc(40rpx + constant(safe-area-inset-bottom));
  height: calc(40rpx + env(safe-area-inset-bottom));
}
